<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS configuration for the production host.

  The live server identifies itself as `Server: Microsoft-IIS/10.0` with
  `X-Powered-By: PleskWin`, so this is IIS on Windows behind Plesk — not Apache.
  IIS ignores .htaccess entirely and reads this file instead.

  What each part does is explained in DEPLOY.md section 14.
-->
<configuration>
  <system.webServer>

    <!--
      SPA fallback.

      React Router owns every URL, so a request that is not a real file has to
      be served index.html and let the client router resolve it. Without this
      rule a refresh or a shared link to /doctors/<id> returns IIS's 404 page.

      A rewrite (not a redirect) keeps the address bar unchanged and returns
      200, which is what the deploy workflow's verification step asserts.

      Requires the IIS URL Rewrite module. If the module is missing IIS returns
      HTTP 500.19 for the whole site, because it cannot parse a section it does
      not understand.
    -->
    <rewrite>
      <rules>
        <rule name="SPA fallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <!-- Real files and directories win: hashed assets, sw.js, manifest.json. -->
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>

    <!--
      index.html and sw.js keep their names across builds, so letting the
      browser cache them hides a deploy until the cached copy expires. The
      service worker exists to make a new build appear immediately, so it must
      not be served from a stale HTTP cache either.

      This is set site-wide rather than per file because IIS does not set any
      Cache-Control for static content by default, so there is nothing to
      finely tune away. It costs nothing here: the service worker caches static
      assets client-side, so they are not re-fetched on every visit.
    -->
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>

  </system.webServer>
</configuration>
